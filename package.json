{
  "name": "pi-thinking-translator",
  "version": "0.2.0",
  "description": "Pi extension package for translating configured visible assistant content blocks.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wplct/pi-thinking-translator.git"
  },
  "homepage": "https://github.com/wplct/pi-thinking-translator#readme",
  "bugs": {
    "url": "https://github.com/wplct/pi-thinking-translator/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "thinking",
    "reasoning",
    "translation"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit --skipLibCheck --moduleResolution bundler --module esnext --target es2022 --types node extensions/thinking-translator.ts",
    "test": "node --test tests/*.test.ts",
    "check": "tsc --noEmit --skipLibCheck --moduleResolution bundler --module esnext --target es2022 --types node extensions/thinking-translator.ts && node --test tests/*.test.ts"
  },
  "files": [
    "extensions",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./extensions/thinking-translator.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "@types/node": "^24.3.0",
    "typescript": "^5.7.3"
  }
}
