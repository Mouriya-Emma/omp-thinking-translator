{
  "name": "omp-thinking-translator",
  "version": "0.6.2",
  "description": "omp extension for translating visible assistant thinking blocks.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mouriya-Emma/omp-thinking-translator.git"
  },
  "homepage": "https://github.com/Mouriya-Emma/omp-thinking-translator#readme",
  "bugs": {
    "url": "https://github.com/Mouriya-Emma/omp-thinking-translator/issues"
  },
  "private": true,
  "keywords": [
    "omp",
    "omp-extension",
    "thinking",
    "translation"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit --skipLibCheck --moduleResolution bundler --module esnext --target es2024 --types node extensions/thinking-translator.ts",
    "test": "bun test tests/thinking-translator.test.ts",
    "check": "pnpm typecheck && pnpm test"
  },
  "files": [
    "extensions",
    "README.md"
  ],
  "omp": {
    "extensions": [
      "./extensions/thinking-translator.ts"
    ]
  },
  "devDependencies": {
    "@oh-my-pi/pi-ai": "18.2.0",
    "@oh-my-pi/pi-coding-agent": "18.2.0",
    "@oh-my-pi/pi-tui": "18.2.0",
    "@types/node": "^24.3.0",
    "typescript": "^5.7.3"
  }
}
